# BOOKVERSE Environment Variables Example
# Duplicate this file to .env and insert your real Supabase credentials.
# Note: Never commit .env or expose your Supabase service_role secret key in frontend code!

# Supabase Project API URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous Key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

